# Local prototype: accessible only from this computer.
HOST=127.0.0.1
PORT=3100
BASE_URL=http://127.0.0.1:3100
ENABLE_DEMO=1
DATABASE_PATH=./data/calendar.sqlite
# Private image storage; default is feedback/ beside DATABASE_PATH. Never use public/.
FEEDBACK_UPLOAD_DIR=
# Create OAuth apps before using real sign-in. Never commit these secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Provider subject IDs, not email addresses; comma separated.
GOOGLE_ADMIN_IDS=
DISCORD_ADMIN_IDS=
# Generate once with: node scripts/generate-vapid.js
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://calendar.toomtoom.online

# Optional legacy source; leave blank for an independent local preview.
CALENDAR_SOURCE_URL=
# Enable only behind the configured tunnel and loopback listener.
CLOUDFLARE_TUNNEL=0

# Calendar service bridge. Distinct keys for platform management and Discord delivery.
CALENDAR_CONTROL_SECRET=
CALENDAR_BOT_SECRET=

# Optional invitation delivery; preassigned invitations work without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Blank: use the existing music bot as transport. Set a different bot token to run Calendar itself.
CALENDAR_DISCORD_TOKEN=
# Set 0 only when running npm run start:bot as a separate service instead of web autostart.
CALENDAR_DISCORD_AUTOSTART=1
